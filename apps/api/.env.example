# Puerto HTTP (Render lo inyecta)
PORT=3000

# Ruta base donde Baileys guarda las sesiones por empresa (credenciales).
# Local: ./data/sessions · Render con disk: /data/sessions
# Cada empresa subcarpeta: {WHATSAPP_SESSION_PATH}/<empresaId>/auth
WHATSAPP_SESSION_PATH=./data/sessions

# URL del backend de empresas (contable). Si se define, el panel puede
# listar empresas desde {EMPRESAS_BACKEND_URL}/api/v1/empresas.
EMPRESAS_BACKEND_URL=

# URL base del backend 1 (contable). Si se define, los mensajes entrantes
# de WhatsApp se reenvían a {BACKEND1_BASE_URL}{BACKEND1_INBOUND_PATH}.
BACKEND1_BASE_URL=

# Token compartido: backend 1 lo usa como "Authorization: Bearer <token>"
# para llamar a POST /webhooks/notify. También se envía al reenviar inbound.
BACKEND1_SHARED_TOKEN=

# Ruta del webhook entrante en backend 1 (por defecto /webhooks/whatsapp-inbound)
BACKEND1_INBOUND_PATH=/webhooks/whatsapp-inbound

# --- LLM (asistente conversacional) ---
# Activa el asistente con LLM. Si se omite, se activa solo cuando hay LLM_API_KEY.
LLM_ENABLED=true

# Clave del proveedor (Groq free tier: https://console.groq.com/keys)
LLM_API_KEY=

# Endpoint compatible con la API de OpenAI (Groq, OpenRouter, Gemini-compat...)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Modelo de chat con soporte de function calling.
# Groq free tier: openai/gpt-oss-20b (rápido) u openai/gpt-oss-120b (más capaz)
LLM_MODEL=openai/gpt-oss-20b

# Límites/rendimiento (opcionales)
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.3
LLM_REASONING_EFFORT=low

# Tiempo máximo de espera a la respuesta síncrona de backend 1
BACKEND1_REPLY_TIMEOUT_MS=10000

# Respuesta cuando el LLM o backend 1 fallan
FALLBACK_REPLY=No pude procesar tu consulta en este momento. Intenta de nuevo en unos minutos.

# Memoria por remitente (número de mensajes y TTL en ms)
CHAT_HISTORY_SIZE=6
CHAT_HISTORY_TTL_MS=1800000

# Prompt de sistema personalizado (opcional)
# LLM_SYSTEM_PROMPT=

# Token para proteger los endpoints de administración del frontend
# (POST /api/whatsapp/connect, /send y ver el QR).
# Si se deja vacío, en desarrollo no se exigen tokens.
BACKEND2_ADMIN_TOKEN=

# Número máximo de reintentos automáticos de conexión (backoff exponencial)
WA_MAX_RECONNECT=8

# Control de acceso: lista de números bolivianos autorizados (separados por coma).
# Formato móvil: 591 + 8 dígitos (empieza en 6 o 7). Vacío = responde a todos.
# Ej.: 59172830478,59171234567
WHATSAPP_ALLOWED_NUMBERS=

# Responder también en grupos de WhatsApp (por defecto solo chats 1:1)
WHATSAPP_ALLOW_GROUPS=false

# Conectar Baileys al arrancar (desactivar en pruebas)
WA_AUTOSTART=true

NODE_ENV=development